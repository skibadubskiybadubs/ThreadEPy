    AHU_1 Heating Coil,      !- Key Name 1
    Heating Coil Heating Energy,  !- Output Variable or Meter Name 1
    AHU_2 Heating Coil,      !- Key Name 2
    Heating Coil Heating Energy;  !- Output Variable or Meter Name 2

Meter:Custom,
    AHU CEDI,                !- Name
    Generic,                 !- Resource Type
    AHU_1 Cooling Coil,      !- Key Name 1
    Cooling Coil Total Cooling Energy,  !- Output Variable or Meter Name 1
    AHU_2 Cooling Coil,      !- Key Name 2
    Cooling Coil Total Cooling Energy;  !- Output Variable or Meter Name 2

Meter:Custom,
    DHW-Load,                !- Name
    Generic,                 !- Resource Type
    *,                       !- Key Name 1
    Water Heater Heating Energy,  !- Output Variable or Meter Name 1
    *,                       !- Key Name 2
    Cooling Coil Total Water Heating Energy;  !- Output Variable or Meter Name 2


