!-   ===========  ALL OBJECTS IN CLASS: OUTPUT:VARIABLEDICTIONARY ===========

Output:VariableDictionary,
    IDF,                     !- Key Field
    Unsorted;                !- Sort Option


!-   ===========  ALL OBJECTS IN CLASS: OUTPUT:TABLE:SUMMARYREPORTS ===========

Output:Table:SummaryReports,
    AllSummary,              !- Report 1 Name
    ElectricComponentsOfPeakDemandMonthly,  !- Report 2 Name
    PeakEnergyEndUseElectricityPart1Monthly,  !- Report 3 Name
    PeakEnergyEndUseElectricityPart2Monthly,  !- Report 4 Name
    PeakEnergyEndUseNaturalGasMonthly;  !- Report 5 Name


!-   ===========  ALL OBJECTS IN CLASS: OUTPUT:TABLE:MONTHLY ===========

Output:Table:Monthly,
    Monthly Loads,           !- Name
    2,                       !- Digits After Decimal
    TEDI Energy,             !- Variable or Meter 1 Name
    SumOrAverage,            !- Aggregation Type for Variable or Meter 1
    AHU TEDI,                !- Variable or Meter 2 Name
    SumOrAverage,            !- Aggregation Type for Variable or Meter 2
    CEDI,                    !- Variable or Meter 3 Name
    SumOrAverage,            !- Aggregation Type for Variable or Meter 3
    AHU CEDI,                !- Variable or Meter 4 Name
    SumOrAverage,            !- Aggregation Type for Variable or Meter 4
    Electricity:Facility,    !- Variable or Meter 5 Name
    SumOrAverage,            !- Aggregation Type for Variable or Meter 5
    NaturalGas:Facility,     !- Variable or Meter 6 Name
    SumOrAverage,            !- Aggregation Type for Variable or Meter 6
    DHW-Energy,              !- Variable or Meter 7 Name
    SumOrAverage,            !- Aggregation Type for Variable or Meter 7
    DHW-Load,                !- Variable or Meter 8 Name
    SumOrAverage;            !- Aggregation Type for Variable or Meter 8


!-   ===========  ALL OBJECTS IN CLASS: OUTPUTCONTROL:TABLE:STYLE ===========

OutputControl:Table:Style,
    HTML,                    !- Column Separator
    JtoGJ;                   !- Unit Conversion


!-   ===========  ALL OBJECTS IN CLASS: OUTPUTCONTROL:REPORTINGTOLERANCES ===========

OutputControl:ReportingTolerances,
